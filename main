//@version=6
strategy("DUI - Improved SMC Risk Strategy", overlay=true,
     initial_capital         = 10000,
     currency                = currency.USD,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.02,
     slippage                = 2,
     backtest_fill_limits_assumption = 1,
     margin_long             = 100,
     margin_short            = 100,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     pyramiding              = 0,
     process_orders_on_close = false,
     calc_on_every_tick      = false,
     use_bar_magnifier       = true)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------

int   swingLength        = input.int(10, "Swing Length (BOS/Structure)", minval=1, group="Structure")
bool  useFVG             = input.bool(true, "Use FVG Entries", group="Structure")
bool  useOB              = input.bool(true, "Use Order Block Entries", group="Structure")
float fvgMinGapPct       = input.float(0.0, "Minimum FVG Gap % (0 = disabled)", minval=0.0, step=0.05, group="Structure")
float fvgMinGapATR       = input.float(0.0, "Minimum FVG Gap x ATR (0 = disabled)", minval=0.0, step=0.05, group="Structure")
float obMinBodyATR       = input.float(0.0, "Minimum OB Displacement Body x ATR (0 = disabled)", minval=0.0, step=0.05, group="Structure")
bool  requireBosForEntry = input.bool(true, "Require Same-Direction BOS for Entry", group="Structure")
bool  requireZoneAfterBOS = input.bool(true, "Require Zone to Form On/After Latest BOS", group="Structure")
bool  consumeZoneOnEntry = input.bool(true, "Consume Triggering Zone After Entry", group="Structure")
bool  allowZoneCreationBarEntry = input.bool(false, "Allow Entry on Zone Formation Bar", group="Structure")
string confluenceExitMode = input.string("Any invalidation", "Confluence Exit Mode", options=["Any invalidation", "All invalidated"], group="Structure")

// --- Filters ---
bool   useTrendFilter   = input.bool(true,  "Use EMA Trend Filter", group="Filters")
int    emaLength        = input.int(200, "EMA Length", minval=1, group="Filters")
bool   useHtfFilter     = input.bool(false, "Use HTF EMA Trend Filter", group="Filters")
string htfTimeframe     = input.timeframe("240", "HTF Timeframe", group="Filters")
int    htfEmaLength     = input.int(200, "HTF EMA Length", minval=1, group="Filters")
bool   useSessionFilter = input.bool(false, "Use Session Filter", group="Filters")
string sessionStr       = input.session("0700-1600", "Trading Session (Exchange Time)", group="Filters")
bool   flattenAtSessionEnd = input.bool(false, "Flatten at Session End", group="Filters")
bool   useDateFilter    = input.bool(false, "Use Date Range Filter", group="Filters")
int    startDateIn      = input.time(timestamp("2020-01-01"), "Start Date", group="Filters")
int    endDateIn        = input.time(timestamp("2030-01-01"), "End Date", group="Filters")
bool   flattenAfterEndDate = input.bool(true, "Flatten After End Date", group="Filters")
bool   useVolFilter     = input.bool(false, "Use Volatility Filter (ATR %)", group="Filters")
float  minAtrPct        = input.float(0.10, "Min ATR % of Price", minval=0.0, step=0.05, group="Filters")
float  maxAtrPct        = input.float(5.0,  "Max ATR % of Price", minval=0.0, step=0.10, group="Filters")

// --- Risk Management ---
float riskLowPct       = input.float(0.75, "Risk % - Single Signal", minval=0.05, maxval=5.0, step=0.05, group="Risk Management")
float riskHighPct      = input.float(1.25, "Risk % - Confluence + BOS Signal", minval=0.05, maxval=5.0, step=0.05, group="Risk Management")
float targetR          = input.float(3.0, "Final Target (R Multiple)", minval=0.5, step=0.1, group="Risk Management")
bool  useDynamicTarget = input.bool(false, "Use Swing High/Low as Target", group="Risk Management")
float minDynamicR      = input.float(1.0, "Minimum Dynamic Target R", minval=0.1, step=0.1, group="Risk Management")
int   maxSwingAgeBars  = input.int(200, "Maximum Swing Target Age (Bars, 0 = unlimited)", minval=0, group="Risk Management")
bool  bosBoostsRisk    = input.bool(true, "Require Fresh BOS for High Risk Tier", group="Risk Management")
int   bosMemoryBars    = input.int(20, "BOS Memory (Bars)", minval=1, group="Risk Management")

float slBufferATRmult  = input.float(0.25, "Stop-Loss Buffer (x ATR)", minval=0.0, step=0.05, group="Risk Management")
int   atrLength        = input.int(14, "ATR Length", minval=1, group="Risk Management")
float minSLpct         = input.float(0.0, "Min SL Distance (% of Price, 0 = off)", minval=0.0, step=0.05, group="Risk Management")
float maxSLpct         = input.float(5.0, "Max SL Distance (% of Price, 0 = off)", minval=0.0, step=0.1, group="Risk Management")
float minSLatrMult     = input.float(0.35, "Min SL Distance (x ATR, 0 = off)", minval=0.0, step=0.05, group="Risk Management")

bool  useCostFloor     = input.bool(true, "Require Stop Distance to Exceed Costs", group="Risk Management")
bool  includeCostsInRisk = input.bool(true, "Include Estimated Costs in Position Risk", group="Risk Management")
float estimatedCommissionPct = input.float(0.02, "Estimated Commission % Per Side", minval=0.0, step=0.005, group="Risk Management", tooltip="Keep this aligned with the commission_value in the strategy declaration.")
float estimatedSlippageTicks = input.float(2.0, "Estimated Slippage Ticks Per Side", minval=0.0, step=0.5, group="Risk Management", tooltip="Keep this aligned with the slippage setting in the strategy declaration.")
float minStopCostMultiple = input.float(3.0, "Min Stop / Estimated Round-Trip Cost", minval=0.0, step=0.25, group="Risk Management")

float pointValueOverride = input.float(0.0, "Point Value in Account Currency (0 = auto)", minval=0.0, step=0.01, group="Position Sizing", tooltip="When set to 0, the script uses syminfo.pointvalue converted into the strategy account currency.")
float maxLeverage      = input.float(1.0, "Max Leverage / Notional Multiple", minval=0.1, step=0.1, group="Position Sizing", tooltip="Values above 1.0 also require lowering margin_long and margin_short in the strategy declaration.")
float qtyStep          = input.float(0.0, "Quantity Step / Lot Size (0 = auto)", minval=0.0, group="Position Sizing", tooltip="When set to 0, stocks and futures are rounded to whole units; other instruments are not rounded.")
float minQty           = input.float(0.0, "Minimum Quantity (0 = none)", minval=0.0, group="Position Sizing")
float maxEntryRiskExpansionPct = input.float(25.0, "Max Adverse Entry Gap / Risk Expansion %", minval=0.0, step=5.0, group="Position Sizing", tooltip="If the actual next-bar fill makes the stop distance more than this percentage larger than the signal-bar risk, the position is closed.")

bool  useBreakEven     = input.bool(true, "Move SL to Break-Even", group="Trade Management")
float beTriggerR       = input.float(1.0, "BE Trigger (Close-Based R Multiple)", minval=0.1, step=0.1, group="Trade Management")
float beBufferTicks    = input.float(1.0, "Break-Even Buffer (Ticks)", minval=0.0, step=0.5, group="Trade Management")
bool  useTrailing      = input.bool(false, "Use ATR Trailing Stop", group="Trade Management")
float trailATRmult     = input.float(1.5, "Trailing Distance (x ATR)", minval=0.1, step=0.1, group="Trade Management")

// --- Global Risk Guard ---
float maxDailyLossPct = input.float(2.0, "Max Daily Loss % (0 = off)", minval=0.0, step=0.1, group="Global Risk Guard")
bool  dailyLossFlatten = input.bool(true, "Flatten on Daily Loss Hit", group="Global Risk Guard")
int   maxConsecutiveLossesPerDay = input.int(3, "Max Consecutive Losses Per Day (0 = off)", minval=0, group="Global Risk Guard")
int   lossCooldownBars = input.int(5, "Cooldown Bars After Loss (0 = off)", minval=0, group="Global Risk Guard")
int   maxTradesPerDay = input.int(0, "Max Entry Orders Per Day (0 = off)", minval=0, group="Global Risk Guard")
float maxStrategyDrawdownPct = input.float(0.0, "Max Strategy Drawdown % Kill Switch (0 = off)", minval=0.0, step=0.5, group="Global Risk Guard")

// -----------------------------------------------------------------------------
// Colors and State
// -----------------------------------------------------------------------------

color bullColor = color.blue
color bearColor = color.red

var bool justEntered = false

// FVG state
var float bullFvgTop    = na
var float bullFvgBottom = na
var bool  bullFvgActive = false
var int   bullFvgCreatedBar = na
var box   bullFvgBox    = na

var float bearFvgTop    = na
var float bearFvgBottom = na
var bool  bearFvgActive = false
var int   bearFvgCreatedBar = na
var box   bearFvgBox    = na

// OB state
var float bullObTop    = na
var float bullObBottom = na
var bool  bullObActive = false
var int   bullObCreatedBar = na
var box   bullObBox    = na

var float bearObTop    = na
var float bearObBottom = na
var bool  bearObActive = false
var int   bearObCreatedBar = na
var box   bearObBox    = na

// Structure
var float swingHigh     = na
var float swingLow      = na
var float lastSwingHigh = na
var float lastSwingLow  = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na

var bool bullishBOS = false
var bool bearishBOS = false
var int  lastBullBOSBar = na
var int  lastBearBOSBar = na

// Trade management state
var float longInitialStop = na
var float longSignalRisk  = na
var float longStop        = na
var float longLimit       = na
var float longInitRisk    = na
var bool  longBracketAdjusted = false
var bool  longFromFvg   = false
var bool  longFromOb    = false
var float longFvgInvalidLevel = na
var float longObInvalidLevel  = na

var float shortInitialStop = na
var float shortSignalRisk  = na
var float shortStop        = na
var float shortLimit       = na
var float shortInitRisk    = na
var bool  shortBracketAdjusted = false
var bool  shortFromFvg   = false
var bool  shortFromOb    = false
var float shortFvgInvalidLevel = na
var float shortObInvalidLevel  = na

// Alert and guard state
var bool longSignalFired  = false
var bool shortSignalFired = false
var bool longEntryFired   = false
var bool shortEntryFired  = false
var bool longExitFired    = false
var bool shortExitFired   = false
var int  lastSignalDirection = 0

var float dayStartEquity = strategy.initial_capital
var float peakEquity = strategy.initial_capital
var int   tradesToday = 0
var int   lossesToday = 0
var int   lastLossBar = na

// -----------------------------------------------------------------------------
// Helper Functions
// -----------------------------------------------------------------------------

f_zoneTouched(float zoneTop, float zoneBottom) =>
    not na(zoneTop) and not na(zoneBottom) and low <= zoneTop and high >= zoneBottom

f_longTarget(float entryPrice, float risk) =>
    float fixedTarget = entryPrice + risk * targetR
    bool swingAgeOk = maxSwingAgeBars <= 0 or (not na(lastSwingHighBar) and (bar_index - lastSwingHighBar) <= maxSwingAgeBars)
    bool dynamicOk = useDynamicTarget and not na(lastSwingHigh) and swingAgeOk and lastSwingHigh > entryPrice and (lastSwingHigh - entryPrice) >= risk * minDynamicR
    dynamicOk ? lastSwingHigh : fixedTarget

f_shortTarget(float entryPrice, float risk) =>
    float fixedTarget = entryPrice - risk * targetR
    bool swingAgeOk = maxSwingAgeBars <= 0 or (not na(lastSwingLowBar) and (bar_index - lastSwingLowBar) <= maxSwingAgeBars)
    bool dynamicOk = useDynamicTarget and not na(lastSwingLow) and swingAgeOk and lastSwingLow < entryPrice and (entryPrice - lastSwingLow) >= risk * minDynamicR
    dynamicOk ? lastSwingLow : fixedTarget

// -----------------------------------------------------------------------------
// Indicators and Filters
// -----------------------------------------------------------------------------

float atr = ta.atr(atrLength)
float ema = ta.ema(close, emaLength)

bool htfTimeframeValid = timeframe.in_seconds(htfTimeframe) > timeframe.in_seconds(timeframe.period)
if useHtfFilter and not htfTimeframeValid
    runtime.error("HTF timeframe must be higher than the chart timeframe.")

// Uses the last confirmed HTF EMA value rather than the currently forming HTF bar.
float htfEmaConfirmed = request.security(
     syminfo.tickerid,
     htfTimeframe,
     ta.ema(close, htfEmaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)
float htfEma = useHtfFilter ? htfEmaConfirmed : na

bool inSession   = not useSessionFilter or not na(time(timeframe.period, sessionStr))
bool inDateRange = not useDateFilter or (time >= startDateIn and time <= endDateIn)

float atrPct = atr / close * 100.0
bool  volOk  = not useVolFilter or (not na(atrPct) and atrPct >= minAtrPct and (maxAtrPct <= 0.0 or atrPct <= maxAtrPct))

// -----------------------------------------------------------------------------
// Daily and Trade-Level Risk Guards
// -----------------------------------------------------------------------------

int dayId = time("D")
bool newDay = na(dayId[1]) or dayId != dayId[1]
if newDay
    dayStartEquity := strategy.equity
    tradesToday := 0
    lossesToday := 0

bool dailyLossHit = false
if maxDailyLossPct > 0 and not na(dayStartEquity) and dayStartEquity > 0
    float dayPnLpct = (strategy.equity - dayStartEquity) / dayStartEquity * 100.0
    dailyLossHit := dayPnLpct <= -maxDailyLossPct

if dailyLossHit and dailyLossFlatten and strategy.position_size != 0
    strategy.close_all(comment="Daily Loss Limit", alert_message="Daily loss limit reached - all positions closed", immediately=true)

peakEquity := math.max(peakEquity, strategy.equity)
bool strategyDrawdownHit = maxStrategyDrawdownPct > 0.0 and peakEquity > 0.0 and (peakEquity - strategy.equity) / peakEquity * 100.0 >= maxStrategyDrawdownPct
if strategyDrawdownHit and strategy.position_size != 0
    strategy.close_all(comment="Strategy Drawdown Kill Switch", alert_message="Strategy drawdown kill switch reached - all positions closed", immediately=true)

bool sessionJustEnded = useSessionFilter and (inSession[1] == true) and not inSession
if flattenAtSessionEnd and sessionJustEnded and strategy.position_size != 0
    strategy.close_all(comment="Session End", alert_message="Session ended - all positions closed", immediately=true)

if useDateFilter and flattenAfterEndDate and time > endDateIn and strategy.position_size != 0
    strategy.close_all(comment="Date Range End", alert_message="Date range ended - all positions closed", immediately=true)

// Reset alert flags for this bar.
longSignalFired  := false
shortSignalFired := false
longEntryFired   := false
shortEntryFired  := false
longExitFired    := false
shortExitFired   := false

bool tradeClosed = strategy.closedtrades > nz(strategy.closedtrades[1], 0)
if tradeClosed
    bool closedTradeWon = strategy.wintrades > nz(strategy.wintrades[1], 0)
    if closedTradeWon
        lossesToday := 0
        lastLossBar := na
    else
        lossesToday += 1
        lastLossBar := bar_index

    if lastSignalDirection > 0
        longExitFired := true
    else if lastSignalDirection < 0
        shortExitFired := true

bool lossCooldownActive = lossCooldownBars > 0 and not na(lastLossBar) and (bar_index - lastLossBar) < lossCooldownBars
bool lossStreakHit = maxConsecutiveLossesPerDay > 0 and lossesToday >= maxConsecutiveLossesPerDay
bool tradeLimitHit = maxTradesPerDay > 0 and tradesToday >= maxTradesPerDay

bool canTrade = inSession and inDateRange and volOk and not dailyLossHit and not strategyDrawdownHit and not lossCooldownActive and not lossStreakHit and not tradeLimitHit

// -----------------------------------------------------------------------------
// Swing / Structure
// -----------------------------------------------------------------------------

float pivotHigh = ta.pivothigh(high, swingLength, swingLength)
float pivotLow  = ta.pivotlow(low, swingLength, swingLength)

if barstate.isconfirmed and not na(pivotHigh)
    swingHigh := pivotHigh
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index
if barstate.isconfirmed and not na(pivotLow)
    swingLow := pivotLow
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index

bullishBOS := false
bearishBOS := false

if barstate.isconfirmed and not na(swingHigh) and close > swingHigh and close[1] <= swingHigh
    bullishBOS := true
    lastBullBOSBar := bar_index
    swingHigh := na
if barstate.isconfirmed and not na(swingLow) and close < swingLow and close[1] >= swingLow
    bearishBOS := true
    lastBearBOSBar := bar_index
    swingLow := na

bool recentBullBOS = not na(lastBullBOSBar) and (bar_index - lastBullBOSBar) <= bosMemoryBars
bool recentBearBOS = not na(lastBearBOSBar) and (bar_index - lastBearBOSBar) <= bosMemoryBars

// -----------------------------------------------------------------------------
// FVG Detection
// -----------------------------------------------------------------------------

bool bullFvgInvalidated = false
bool bearFvgInvalidated = false

if useFVG
    bool bullFvgFormed = barstate.isconfirmed and low > high[2]
    bool bearFvgFormed = barstate.isconfirmed and high < low[2]

    float bullGapSize = bullFvgFormed ? low - high[2] : na
    float bearGapSize = bearFvgFormed ? low[2] - high : na

    bool bullGapPctOk = fvgMinGapPct <= 0.0 or (bullGapSize / close * 100.0) >= fvgMinGapPct
    bool bearGapPctOk = fvgMinGapPct <= 0.0 or (bearGapSize / close * 100.0) >= fvgMinGapPct
    bool bullGapAtrOk = fvgMinGapATR <= 0.0 or (not na(atr) and bullGapSize >= fvgMinGapATR * atr)
    bool bearGapAtrOk = fvgMinGapATR <= 0.0 or (not na(atr) and bearGapSize >= fvgMinGapATR * atr)

    bool bullFvgValid = bullFvgFormed and bullGapPctOk and bullGapAtrOk
    bool bearFvgValid = bearFvgFormed and bearGapPctOk and bearGapAtrOk

    if bullFvgValid
        if bullFvgActive and not na(bullFvgBox)
            box.delete(bullFvgBox)
        bullFvgTop := low
        bullFvgBottom := high[2]
        bullFvgActive := true
        bullFvgCreatedBar := bar_index
        bullFvgBox := box.new(bar_index[2], bullFvgTop, bar_index, bullFvgBottom,
             border_color=bullColor, bgcolor=color.new(bullColor, 85))

    if bearFvgValid
        if bearFvgActive and not na(bearFvgBox)
            box.delete(bearFvgBox)
        bearFvgTop := low[2]
        bearFvgBottom := high
        bearFvgActive := true
        bearFvgCreatedBar := bar_index
        bearFvgBox := box.new(bar_index[2], bearFvgTop, bar_index, bearFvgBottom,
             border_color=bearColor, bgcolor=color.new(bearColor, 85))

    bullFvgInvalidated := bullFvgActive and barstate.isconfirmed and not na(bullFvgBottom) and close < bullFvgBottom
    bearFvgInvalidated := bearFvgActive and barstate.isconfirmed and not na(bearFvgTop) and close > bearFvgTop

    if bullFvgInvalidated
        bullFvgActive := false
        bullFvgCreatedBar := na
        if not na(bullFvgBox)
            box.delete(bullFvgBox)
            bullFvgBox := na
        bullFvgTop := na
        bullFvgBottom := na
    if bearFvgInvalidated
        bearFvgActive := false
        bearFvgCreatedBar := na
        if not na(bearFvgBox)
            box.delete(bearFvgBox)
            bearFvgBox := na
        bearFvgTop := na
        bearFvgBottom := na

if bullFvgActive and not na(bullFvgBox)
    box.set_right(bullFvgBox, bar_index + 1)
if bearFvgActive and not na(bearFvgBox)
    box.set_right(bearFvgBox, bar_index + 1)

// -----------------------------------------------------------------------------
// Order Block Detection
// -----------------------------------------------------------------------------

bool bullObInvalidated = false
bool bearObInvalidated = false

if useOB
    float bullBody = close - open
    float bearBody = open - close
    bool bullDisplacementOk = obMinBodyATR <= 0.0 or (not na(atr) and bullBody >= obMinBodyATR * atr)
    bool bearDisplacementOk = obMinBodyATR <= 0.0 or (not na(atr) and bearBody >= obMinBodyATR * atr)

    bool strongBullMove = barstate.isconfirmed and close > high[1] and close[1] < open[1] and bullBody > (high[1] - low[1]) and bullDisplacementOk
    bool strongBearMove = barstate.isconfirmed and close < low[1] and close[1] > open[1] and bearBody > (high[1] - low[1]) and bearDisplacementOk

    if strongBullMove
        if bullObActive and not na(bullObBox)
            box.delete(bullObBox)
        bullObTop := open[1]
        bullObBottom := low[1]
        bullObActive := true
        bullObCreatedBar := bar_index
        bullObBox := box.new(bar_index[1], bullObTop, bar_index, bullObBottom,
             border_color=bullColor, bgcolor=color.new(bullColor, 90))

    if strongBearMove
        if bearObActive and not na(bearObBox)
            box.delete(bearObBox)
        bearObTop := high[1]
        bearObBottom := open[1]
        bearObActive := true
        bearObCreatedBar := bar_index
        bearObBox := box.new(bar_index[1], bearObTop, bar_index, bearObBottom,
             border_color=bearColor, bgcolor=color.new(bearColor, 90))

    bullObInvalidated := bullObActive and barstate.isconfirmed and not na(bullObBottom) and close < bullObBottom
    bearObInvalidated := bearObActive and barstate.isconfirmed and not na(bearObTop) and close > bearObTop

    if bullObInvalidated
        bullObActive := false
        bullObCreatedBar := na
        if not na(bullObBox)
            box.delete(bullObBox)
            bullObBox := na
        bullObTop := na
        bullObBottom := na
    if bearObInvalidated
        bearObActive := false
        bearObCreatedBar := na
        if not na(bearObBox)
            box.delete(bearObBox)
            bearObBox := na
        bearObTop := na
        bearObBottom := na

if bullObActive and not na(bullObBox)
    box.set_right(bullObBox, bar_index + 1)
if bearObActive and not na(bearObBox)
    box.set_right(bearObBox, bar_index + 1)

// -----------------------------------------------------------------------------
// Entry Conditions
// -----------------------------------------------------------------------------

bool bullFvgAgeOk = allowZoneCreationBarEntry or (not na(bullFvgCreatedBar) and bar_index > bullFvgCreatedBar)
bool bearFvgAgeOk = allowZoneCreationBarEntry or (not na(bearFvgCreatedBar) and bar_index > bearFvgCreatedBar)
bool bullObAgeOk  = allowZoneCreationBarEntry or (not na(bullObCreatedBar) and bar_index > bullObCreatedBar)
bool bearObAgeOk  = allowZoneCreationBarEntry or (not na(bearObCreatedBar) and bar_index > bearObCreatedBar)

bool priceInBullFvg = useFVG and bullFvgActive and bullFvgAgeOk and f_zoneTouched(bullFvgTop, bullFvgBottom)
bool priceInBearFvg = useFVG and bearFvgActive and bearFvgAgeOk and f_zoneTouched(bearFvgTop, bearFvgBottom)
bool priceInBullOb  = useOB and bullObActive and bullObAgeOk and f_zoneTouched(bullObTop, bullObBottom)
bool priceInBearOb  = useOB and bearObActive and bearObAgeOk and f_zoneTouched(bearObTop, bearObBottom)

bool bullFvgAfterBOS = not na(bullFvgCreatedBar) and not na(lastBullBOSBar) and bullFvgCreatedBar >= lastBullBOSBar
bool bullObAfterBOS  = not na(bullObCreatedBar) and not na(lastBullBOSBar) and bullObCreatedBar >= lastBullBOSBar
bool bearFvgAfterBOS = not na(bearFvgCreatedBar) and not na(lastBearBOSBar) and bearFvgCreatedBar >= lastBearBOSBar
bool bearObAfterBOS  = not na(bearObCreatedBar) and not na(lastBearBOSBar) and bearObCreatedBar >= lastBearBOSBar

bool bullCausalZone = (priceInBullFvg and bullFvgAfterBOS) or (priceInBullOb and bullObAfterBOS)
bool bearCausalZone = (priceInBearFvg and bearFvgAfterBOS) or (priceInBearOb and bearObAfterBOS)

bool bullStructureActive = recentBullBOS and (na(lastBearBOSBar) or lastBullBOSBar > lastBearBOSBar)
bool bearStructureActive = recentBearBOS and (na(lastBullBOSBar) or lastBearBOSBar > lastBullBOSBar)
bool bullBosQuality = bullStructureActive and (not requireZoneAfterBOS or bullCausalZone)
bool bearBosQuality = bearStructureActive and (not requireZoneAfterBOS or bearCausalZone)

bool longStructureOk  = not requireBosForEntry or bullBosQuality
bool shortStructureOk = not requireBosForEntry or bearBosQuality

bool trendOkLong  = not useTrendFilter or (not na(ema) and close > ema)
bool trendOkShort = not useTrendFilter or (not na(ema) and close < ema)

// Fail closed while the HTF EMA is warming up or unavailable.
bool htfOkLong  = not useHtfFilter or (not na(htfEma) and close > htfEma)
bool htfOkShort = not useHtfFilter or (not na(htfEma) and close < htfEma)

bool bullZoneSignal = priceInBullFvg or priceInBullOb
bool bearZoneSignal = priceInBearFvg or priceInBearOb

bool longCondition = barstate.isconfirmed and strategy.position_size == 0 and canTrade and trendOkLong and htfOkLong and bullZoneSignal and longStructureOk and close > open
bool shortCondition = barstate.isconfirmed and strategy.position_size == 0 and canTrade and trendOkShort and htfOkShort and bearZoneSignal and shortStructureOk and close < open

// High risk now requires both zone confluence and a valid same-direction BOS.
bool longConfluence  = priceInBullFvg and priceInBullOb
bool shortConfluence = priceInBearFvg and priceInBearOb
bool longStrong  = longConfluence and (not bosBoostsRisk or bullBosQuality)
bool shortStrong = shortConfluence and (not bosBoostsRisk or bearBosQuality)

float longRiskPct  = longStrong ? riskHighPct : riskLowPct
float shortRiskPct = shortStrong ? riskHighPct : riskLowPct

float quoteRateRaw = request.currency_rate(syminfo.currency, strategy.account_currency, true)
float quoteToAccountRate = nz(quoteRateRaw, 1.0)
float symbolPointValue = syminfo.pointvalue
bool pointValueOk = pointValueOverride > 0.0 or (not na(symbolPointValue) and not na(quoteRateRaw))
float effectivePointValue = pointValueOverride > 0.0 ? pointValueOverride : symbolPointValue * quoteToAccountRate
float estimatedRoundTripCost = close * (2.0 * estimatedCommissionPct / 100.0) + 2.0 * estimatedSlippageTicks * syminfo.mintick
bool requiresWholeQuantity = syminfo.type == "stock" or syminfo.type == "futures"
float effectiveQtyStep = qtyStep > 0.0 ? qtyStep : (requiresWholeQuantity ? 1.0 : 0.0)

// -----------------------------------------------------------------------------
// Entries
// -----------------------------------------------------------------------------

if longCondition
    longFromFvg := priceInBullFvg
    longFromOb := priceInBullOb

    float baseSL = na
    if longFromFvg
        baseSL := bullFvgBottom
    if longFromOb
        baseSL := na(baseSL) ? bullObBottom : math.max(baseSL, bullObBottom)
    if na(baseSL)
        baseSL := low

    float proposedStop = baseSL - slBufferATRmult * atr
    float slDist = close - proposedStop
    float slPct = slDist / close * 100.0

    bool atrStopOk = minSLatrMult <= 0.0 or (not na(atr) and slDist >= minSLatrMult * atr)
    bool costOk = not useCostFloor or slDist >= estimatedRoundTripCost * minStopCostMultiple
    bool slOk = not na(slDist) and slDist > 0 and atrStopOk and costOk and (minSLpct <= 0.0 or slPct >= minSLpct) and (maxSLpct <= 0.0 or slPct <= maxSLpct)

    if slOk and pointValueOk and effectivePointValue > 0
        float riskAmt = strategy.equity * (longRiskPct / 100.0)
        float riskDistance = slDist + (includeCostsInRisk ? estimatedRoundTripCost : 0.0)
        float riskQty = riskAmt / (riskDistance * effectivePointValue)
        float maxQty = strategy.equity * maxLeverage / (close * effectivePointValue * (1.0 + estimatedCommissionPct / 100.0))
        float qty = math.min(riskQty, maxQty)
        if effectiveQtyStep > 0.0
            qty := math.floor(qty / effectiveQtyStep) * effectiveQtyStep

        bool qtyOk = not na(qty) and qty > 0.0 and qty >= minQty
        if qtyOk
            longInitialStop := proposedStop
            longSignalRisk := slDist
            longStop := proposedStop
            longInitRisk := slDist
            longLimit := f_longTarget(close, slDist)
            longBracketAdjusted := false

            // Snapshot the exact zone levels that caused this entry.
            longFvgInvalidLevel := longFromFvg ? bullFvgBottom : na
            longObInvalidLevel := longFromOb ? bullObBottom : na

            strategy.entry("Long", strategy.long, qty=qty, comment="Long Entry", alert_message="SMC long entry order submitted")
            strategy.exit("Long Exit", "Long", stop=longStop, limit=longLimit, comment="Long Initial Bracket", alert_message="SMC long initial bracket triggered")

            tradesToday += 1
            lastSignalDirection := 1
            justEntered := true
            longSignalFired := true

            if consumeZoneOnEntry
                if longFromFvg
                    bullFvgActive := false
                    bullFvgCreatedBar := na
                    if not na(bullFvgBox)
                        box.delete(bullFvgBox)
                        bullFvgBox := na
                    bullFvgTop := na
                    bullFvgBottom := na
                if longFromOb
                    bullObActive := false
                    bullObCreatedBar := na
                    if not na(bullObBox)
                        box.delete(bullObBox)
                        bullObBox := na
                    bullObTop := na
                    bullObBottom := na

if shortCondition
    shortFromFvg := priceInBearFvg
    shortFromOb := priceInBearOb

    float baseSL = na
    if shortFromFvg
        baseSL := bearFvgTop
    if shortFromOb
        baseSL := na(baseSL) ? bearObTop : math.min(baseSL, bearObTop)
    if na(baseSL)
        baseSL := high

    float proposedStop = baseSL + slBufferATRmult * atr
    float slDist = proposedStop - close
    float slPct = slDist / close * 100.0

    bool atrStopOk = minSLatrMult <= 0.0 or (not na(atr) and slDist >= minSLatrMult * atr)
    bool costOk = not useCostFloor or slDist >= estimatedRoundTripCost * minStopCostMultiple
    bool slOk = not na(slDist) and slDist > 0 and atrStopOk and costOk and (minSLpct <= 0.0 or slPct >= minSLpct) and (maxSLpct <= 0.0 or slPct <= maxSLpct)

    if slOk and pointValueOk and effectivePointValue > 0
        float riskAmt = strategy.equity * (shortRiskPct / 100.0)
        float riskDistance = slDist + (includeCostsInRisk ? estimatedRoundTripCost : 0.0)
        float riskQty = riskAmt / (riskDistance * effectivePointValue)
        float maxQty = strategy.equity * maxLeverage / (close * effectivePointValue * (1.0 + estimatedCommissionPct / 100.0))
        float qty = math.min(riskQty, maxQty)
        if effectiveQtyStep > 0.0
            qty := math.floor(qty / effectiveQtyStep) * effectiveQtyStep

        bool qtyOk = not na(qty) and qty > 0.0 and qty >= minQty
        if qtyOk
            shortInitialStop := proposedStop
            shortSignalRisk := slDist
            shortStop := proposedStop
            shortInitRisk := slDist
            shortLimit := f_shortTarget(close, slDist)
            shortBracketAdjusted := false

            shortFvgInvalidLevel := shortFromFvg ? bearFvgTop : na
            shortObInvalidLevel := shortFromOb ? bearObTop : na

            strategy.entry("Short", strategy.short, qty=qty, comment="Short Entry", alert_message="SMC short entry order submitted")
            strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortLimit, comment="Short Initial Bracket", alert_message="SMC short initial bracket triggered")

            tradesToday += 1
            lastSignalDirection := -1
            justEntered := true
            shortSignalFired := true

            if consumeZoneOnEntry
                if shortFromFvg
                    bearFvgActive := false
                    bearFvgCreatedBar := na
                    if not na(bearFvgBox)
                        box.delete(bearFvgBox)
                        bearFvgBox := na
                    bearFvgTop := na
                    bearFvgBottom := na
                if shortFromOb
                    bearObActive := false
                    bearObCreatedBar := na
                    if not na(bearObBox)
                        box.delete(bearObBox)
                        bearObBox := na
                    bearObTop := na
                    bearObBottom := na

// -----------------------------------------------------------------------------
// Trade Management and Exits
// -----------------------------------------------------------------------------

if strategy.position_size > 0
    float entry = strategy.position_avg_price

    // Recalculate R from the actual fill price because entries execute on the next bar.
    if not longBracketAdjusted
        float actualRisk = na(longInitialStop) ? na : entry - longInitialStop
        bool validRisk = not na(actualRisk) and actualRisk > 0.0
        bool expansionOk = validRisk and not na(longSignalRisk) and actualRisk <= longSignalRisk * (1.0 + maxEntryRiskExpansionPct / 100.0)
        if validRisk and expansionOk
            longInitRisk := actualRisk
            longLimit := f_longTarget(entry, longInitRisk)
            longBracketAdjusted := true
        else
            strategy.close("Long", comment="Invalid/Expanded Long Risk", alert_message="SMC long closed after invalid or expanded risk", immediately=true)

    if longBracketAdjusted
        bool longBeTrigger = useBreakEven and not na(longInitRisk) and close >= entry + beTriggerR * longInitRisk
        if longBeTrigger and not na(longStop)
            longStop := math.max(longStop, entry + beBufferTicks * syminfo.mintick)
        if useTrailing and not na(longStop) and not na(atr)
            longStop := math.max(longStop, close - trailATRmult * atr)

        bool longFvgBad = longFromFvg and not na(longFvgInvalidLevel) and close < longFvgInvalidLevel
        bool longObBad = longFromOb and not na(longObInvalidLevel) and close < longObInvalidLevel
        int longTriggerCount = (longFromFvg ? 1 : 0) + (longFromOb ? 1 : 0)
        int longInvalidCount = (longFvgBad ? 1 : 0) + (longObBad ? 1 : 0)
        bool longExitSignal = longTriggerCount > 0 and (confluenceExitMode == "Any invalidation" ? longInvalidCount > 0 : longInvalidCount >= longTriggerCount)

        if longExitSignal
            strategy.close("Long", comment="Structure Invalidated", alert_message="SMC long closed - structure invalidated")
        else
            strategy.exit("Long Exit", "Long", stop=longStop, limit=longLimit, comment="Long Exit", alert_message="SMC long bracket exit triggered")

if strategy.position_size < 0
    float entry = strategy.position_avg_price

    if not shortBracketAdjusted
        float actualRisk = na(shortInitialStop) ? na : shortInitialStop - entry
        bool validRisk = not na(actualRisk) and actualRisk > 0.0
        bool expansionOk = validRisk and not na(shortSignalRisk) and actualRisk <= shortSignalRisk * (1.0 + maxEntryRiskExpansionPct / 100.0)
        if validRisk and expansionOk
            shortInitRisk := actualRisk
            shortLimit := f_shortTarget(entry, shortInitRisk)
            shortBracketAdjusted := true
        else
            strategy.close("Short", comment="Invalid/Expanded Short Risk", alert_message="SMC short closed after invalid or expanded risk", immediately=true)

    if shortBracketAdjusted
        bool shortBeTrigger = useBreakEven and not na(shortInitRisk) and close <= entry - beTriggerR * shortInitRisk
        if shortBeTrigger and not na(shortStop)
            shortStop := math.min(shortStop, entry - beBufferTicks * syminfo.mintick)
        if useTrailing and not na(shortStop) and not na(atr)
            shortStop := math.min(shortStop, close + trailATRmult * atr)

        bool shortFvgBad = shortFromFvg and not na(shortFvgInvalidLevel) and close > shortFvgInvalidLevel
        bool shortObBad = shortFromOb and not na(shortObInvalidLevel) and close > shortObInvalidLevel
        int shortTriggerCount = (shortFromFvg ? 1 : 0) + (shortFromOb ? 1 : 0)
        int shortInvalidCount = (shortFvgBad ? 1 : 0) + (shortObBad ? 1 : 0)
        bool shortExitSignal = shortTriggerCount > 0 and (confluenceExitMode == "Any invalidation" ? shortInvalidCount > 0 : shortInvalidCount >= shortTriggerCount)

        if shortExitSignal
            strategy.close("Short", comment="Structure Invalidated", alert_message="SMC short closed - structure invalidated")
        else
            strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortLimit, comment="Short Exit", alert_message="SMC short bracket exit triggered")

// Entry alerts reflect an actual open position rather than only an order submission.
float previousPositionSize = nz(strategy.position_size[1], 0.0)
longEntryFired := strategy.position_size > 0 and previousPositionSize <= 0
shortEntryFired := strategy.position_size < 0 and previousPositionSize >= 0

// -----------------------------------------------------------------------------
// Reset Trade State When Flat
// -----------------------------------------------------------------------------

if strategy.position_size == 0 and not justEntered
    longInitialStop := na
    longSignalRisk := na
    longStop := na
    longLimit := na
    longInitRisk := na
    longBracketAdjusted := false
    longFromFvg := false
    longFromOb := false
    longFvgInvalidLevel := na
    longObInvalidLevel := na

    shortInitialStop := na
    shortSignalRisk := na
    shortStop := na
    shortLimit := na
    shortInitRisk := na
    shortBracketAdjusted := false
    shortFromFvg := false
    shortFromOb := false
    shortFvgInvalidLevel := na
    shortObInvalidLevel := na

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------

plot(useTrendFilter ? ema : na, "EMA Trend", color=color.orange, linewidth=1)
plot(useHtfFilter ? htfEma : na, "Confirmed HTF EMA", color=color.new(color.purple, 40), linewidth=1)

plot(strategy.position_size > 0 ? longStop : na, "Long Stop", color=color.new(color.red, 20), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size > 0 ? longLimit : na, "Long Target", color=color.new(color.green, 20), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortStop : na, "Short Stop", color=color.new(color.red, 20), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortLimit : na, "Short Target", color=color.new(color.green, 20), linewidth=1, style=plot.style_linebr)

plotshape(bullishBOS, title="Bullish BOS", style=shape.labelup, location=location.belowbar, color=bullColor, text="BOS", textcolor=color.white, size=size.tiny)
plotshape(bearishBOS, title="Bearish BOS", style=shape.labeldown, location=location.abovebar, color=bearColor, text="BOS", textcolor=color.white, size=size.tiny)
plotshape(longSignalFired, title="Long Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(shortSignalFired, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

bgcolor(useSessionFilter and not inSession ? color.new(color.gray, 90) : na)
bgcolor(lossCooldownActive or lossStreakHit ? color.new(color.orange, 88) : na)
bgcolor(strategyDrawdownHit ? color.new(color.purple, 82) : na)
bgcolor(dailyLossHit ? color.new(color.red, 85) : na)

// -----------------------------------------------------------------------------
// Alert Conditions
// -----------------------------------------------------------------------------

alertcondition(longSignalFired, title="SMC Long Signal / Order Submitted", message="SMC long signal confirmed and order submitted")
alertcondition(shortSignalFired, title="SMC Short Signal / Order Submitted", message="SMC short signal confirmed and order submitted")
alertcondition(longEntryFired, title="SMC Long Position Opened", message="SMC long position is open")
alertcondition(shortEntryFired, title="SMC Short Position Opened", message="SMC short position is open")
alertcondition(longExitFired, title="SMC Long Trade Closed", message="SMC long trade closed")
alertcondition(shortExitFired, title="SMC Short Trade Closed", message="SMC short trade closed")
alertcondition(dailyLossHit, title="Daily Loss Limit Hit", message="Daily loss limit reached - trading paused")
alertcondition(strategyDrawdownHit, title="Strategy Drawdown Kill Switch", message="Maximum strategy drawdown reached - trading stopped")
alertcondition(not pointValueOk, title="Position Sizing Data Unavailable", message="Point value or currency conversion unavailable - entries are blocked")

// Clear the one-bar entry latch after all calculations.
justEntered := false
